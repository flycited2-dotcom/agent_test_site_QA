# ════════════════════════════════════════════════════════════════════════════
# CRM QA AGENTS — команда агентов для тестирования CRM 24/7
# ════════════════════════════════════════════════════════════════════════════

# ── CRM сервер ───────────────────────────────────────────────────────────────
CRM_BASE_URL=https://crm.your-domain.ru
CRM_LOGIN_PATH=/login
CRM_DASHBOARD_PATH=/

# ── Пути к разделам CRM (меняйте под вашу CRM) ───────────────────────────────
CRM_LEADS_PATH=/leads
CRM_CLIENTS_PATH=/clients
CRM_TASKS_PATH=/tasks
CRM_DEALS_PATH=/deals
CRM_ANALYTICS_PATH=/analytics
CRM_REPORTS_PATH=/reports
CRM_SETTINGS_PATH=/settings
CRM_USERS_PATH=/settings/users

# ── Учётные записи ───────────────────────────────────────────────────────────
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=your-admin-password
# Отдельный менеджер для теста разграничения прав (если нет — оставьте пустыми)
CRM_MANAGER_EMAIL=
CRM_MANAGER_PASSWORD=

# ── Входящие каналы (Agent 6 — Incoming) ─────────────────────────────────────
# URL формы на сайте (для HTTP POST симуляции), обычно = BASE_URL
CRM_SITE_FORM_URL=https://climat-simf.ru/
# Путь до form handler (если отдельный endpoint, напр. /ajax/form)
CRM_SITE_FORM_PATH=/
# REST API сайта для прямой отправки заявки (если есть)
CRM_SITE_API_URL=
# Webhook URL вашего Telegram-бота CRM (куда Telegram шлёт updates)
CRM_TELEGRAM_WEBHOOK_URL=
# Secret token для X-Telegram-Bot-Api-Secret-Token (если настроен)
CRM_TELEGRAM_SECRET=
# Email-ящик CRM, на который приходят заявки из почты
CRM_INBOX_EMAIL=

# ── Таймауты и режим ─────────────────────────────────────────────────────────
CRM_TIMEOUT_MS=20000
# Режим расписания: smoke | critical | full
CRM_QA_MODE=smoke

# ════════════════════════════════════════════════════════════════════════════

SMOKE_INTERVAL_MINUTES=30
CRITICAL_INTERVAL_MINUTES=120
FULL_INTERVAL_MINUTES=360
FULL_RUN_HOUR=3
TIMEZONE=Europe/Moscow
