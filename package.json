{
  "name": "climat-simf-qa-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "cross-env QA_MODE=smoke playwright test tests/01-smoke.spec.ts",
    "test:critical": "cross-env QA_MODE=critical playwright test tests/02-critical-path.spec.ts tests/03-forms-links.spec.ts",
    "test:full": "cross-env QA_MODE=full playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report reports/html",
    "qa:discover": "tsx src/discovery/discover.ts",
    "qa:summary": "tsx src/reporters/build-summary.ts",
    "qa:telegram": "tsx src/telegram/send-summary.ts",
    "qa:bot": "tsx src/telegram/bot.ts",
    "qa:drive": "tsx src/google-drive/upload-report.ts",
    "qa:email": "tsx src/email/send-report.ts",
    "qa:drive:auth": "tsx src/google-drive/authorize.ts",
    "qa:run:smoke": "tsx src/runner/run-qa.ts smoke",
    "qa:run:critical": "tsx src/runner/run-qa.ts critical",
    "qa:run:full": "tsx src/runner/run-qa.ts full"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.3.0",
    "googleapis": "^166.0.0",
    "nodemailer": "^8.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
