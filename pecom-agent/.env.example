# ── ПЭК: API личного кабинета (https://kabinet.pecom.ru/api/v1/) ──
# Логин = имя пользователя личного кабинета ПЭК (с которым входите на kabinet.pecom.ru)
PEC_LOGIN=
# Ключ API: ЛК ПЭК → «Регистрационные данные» → «Ключи API»
PEC_API_KEY=
# Тарифы для расчёта: 3 — LTL Авто, 1 — Express Авиа, 12 — EasyWay (нужен договор)
PEC_CALC_TYPES=3,1

# ── Telegram ──
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Кому разрешён доступ (chat id через запятую). Узнать свой id: написать боту — он пришлёт id.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── ИИ-помощник (необязательно): понимает свободный текст ──
# Ключ с https://console.anthropic.com/ . Без ключа бот работает на кнопках и командах.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — глубина рассуждений (low — быстрее и дешевле)
ANTHROPIC_EFFORT=low

# ── Прочее ──
# Как часто проверять грузы с подпиской «Следить», минут
WATCH_INTERVAL_MINUTES=30
STORAGE_DIR=storage
